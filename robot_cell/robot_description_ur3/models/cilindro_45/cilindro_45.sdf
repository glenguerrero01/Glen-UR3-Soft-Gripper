<?xml version="1.0" ?>
<!-- Cilindro solido. Diametro 45 mm (radio 0.0225 m) x altura 100 mm.
     Masa 50 g. Friccion mu=mu2=1.0. Eje vertical (de pie).
     Inercia: Izz=1.2656e-05  Ixx=Iyy=4.7995e-05 -->
<sdf version="1.10">
  <model name="cilindro_45">
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>4.7995e-05</ixx><iyy>4.7995e-05</iyy><izz>1.2656e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.0225</radius><length>0.1</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>1e2</kd></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.0225</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
