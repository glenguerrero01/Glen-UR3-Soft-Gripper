<?xml version="1.0" ?>
<!-- Esfera D=65 mm.  Masa 50 g. Friccion mu=mu2=1.2. -->
<sdf version="1.10">
  <model name="esfera_65">
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>2.1125e-05</ixx><iyy>2.1125e-05</iyy><izz>2.1125e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.0325</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>1e2</kd></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.0325</radius></sphere></geometry>
        <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
