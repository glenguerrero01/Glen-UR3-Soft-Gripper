# Panel plano para el logo TFM (4.5 x 1.24 m), centrado en el origen.
# Cara frontal con normal +Y (mira hacia el robot).
mtllib logo_panel.mtl
o logo_panel
v -2.25 0 -0.62
v  2.25 0 -0.62
v  2.25 0  0.62
v -2.25 0  0.62
vt 1 0
vt 0 0
vt 0 1
vt 1 1
vn 0 1 0
usemtl logo
f 1/1/1 4/4/1 3/3/1
f 1/1/1 3/3/1 2/2/1
