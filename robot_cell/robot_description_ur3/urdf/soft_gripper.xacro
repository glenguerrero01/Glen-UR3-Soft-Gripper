<?xml version="1.0"?>
<!-- ============================================================================
     soft_gripper.xacro   (4 segmentos por dedo)
     Pinza blanda bioinspirada tipo peine/fin-ray, actuacion NEUMATICA, para UR3.

     Corte del dedo (desde la base del Ø6):
        seg1 = 0-11.25 mm  -> bloque base (Ø6), FIJO al acople
        seg2 = 11.25-33 mm | seg3 = 33-55 mm | seg4 = 55-88 mm (peine + punta R8)

     Modelo (Gazebo/DART rigido): base fija + flexion neumatica aproximada.
       ACOPLADO (por defecto): g_left_joint es la MAESTRA; el resto por 'mimic'
       -> 1 comando = "presion" (curvatura ~cte). Alternativa compliante al final.

     ACOPLE:
       El acople.stl fue RECOLOCADO fuera de Fusion: origen en el centro de la
       cara que apoya en tool0, Z hacia los dedos (aproximacion). Por eso g_mount
       queda en IDENTIDAD y el <visual> del acople no lleva <origin>.
       Inercia calculada desde la malla, escalada a 75.789 g.
     ============================================================================ -->
<robot name="soft_gripper" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="soft_blue"><color rgba="0.15 0.45 0.85 1"/></material>
  <material name="mount_grey"><color rgba="0.6 0.6 0.62 1"/></material>

  <!-- ===== Escala de malla: STL en mm -> 0.001 ===== -->
  <xacro:property name="ms" value="0.001"/>
  <xacro:property name="mesh_dir" value="package://robot_description_ur3/meshes/gripper_soft"/>
  <xacro:property name="acople_mesh" value="${mesh_dir}/acople.stl"/>

  <!-- ===== Longitudes de cada segmento (m) ===== -->
  <xacro:property name="l1" value="0.01125"/>
  <xacro:property name="l2" value="0.02175"/>
  <xacro:property name="l3" value="0.02200"/>
  <xacro:property name="l4" value="0.03300"/>

  <!-- Distancia acumulada desde la base al INICIO de cada segmento (m) -->
  <xacro:property name="c1" value="0.0"/>
  <xacro:property name="c2" value="0.01125"/>
  <xacro:property name="c3" value="0.03300"/>
  <xacro:property name="c4" value="0.05500"/>

  <!-- Seccion del dedo (ancho Y, alto Z) ~20x20 mm -->
  <xacro:property name="fw" value="0.020"/>
  <xacro:property name="fh" value="0.020"/>

  <!-- Colocacion de los dedos, del plano de seccion del acople:
       boca de boquilla Y=24.22 mm, Z=25 mm ; ejes a 35 deg de la vertical.
       root_rpy: pitch=-54.99 deg (apunta el dedo por +Z inclinado 35),
       yaw=+/-90 deg orienta cada dedo a su lado. -->
  <!-- Punto de entrada de la boquilla, MEDIDO de la malla del acople -->
  <xacro:property name="mouth_y" value="0.03"/>   <!-- Y de la entrada (lateral) -->
  <xacro:property name="mouth_z" value="0.042"/>   <!-- Z de la entrada (profundidad) -->
  <!-- Giro del dedo sobre su eje: 3.1416 = volteado, 0 = sin voltear.
       Si los dedos salen invertidos, alterna entre estos dos valores. -->
  <xacro:property name="finger_roll" value="3.1416"/>

  <!-- Eje de flexion de las juntas del peine -->
  <xacro:property name="bend_axis" value="0 1 0"/>

  <!-- ====== Macro: inercia de caja ====== -->
  <xacro:macro name="box_inertia" params="m x y z ox">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="${ox} 0 0"/>
      <inertia
        ixx="${(1.0/12.0)*m*(y*y + z*z)}"
        iyy="${(1.0/12.0)*m*(x*x + z*z)}"
        izz="${(1.0/12.0)*m*(x*x + y*y)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ====== Macro: un segmento (falange) ====== -->
  <xacro:macro name="seg" params="name mesh slen comp mass">
    <link name="${name}">
      <visual>
        <!-- comp centra en X (dist. acumulada) ; -fw/2,-fh/2 centra la seccion,
             porque el origen del STL esta en una esquina, no en el eje del dedo -->
        <origin xyz="${comp} ${-fw/2} ${-fh/2}"/>
        <geometry><mesh filename="${mesh_dir}/${mesh}" scale="${ms} ${ms} ${ms}"/></geometry>
        <material name="soft_blue"/>
      </visual>
      <collision>
        <geometry><box size="${slen} ${fw} ${fh}"/></geometry>
        <origin xyz="${0.5*slen} 0 0"/>
      </collision>
      <xacro:box_inertia m="${mass}" x="${slen}" y="${fw}" z="${fh}" ox="${0.5*slen}"/>
    </link>
  </xacro:macro>

  <!-- ====== Macro: un dedo de 4 segmentos ====== -->
  <xacro:macro name="finger" params="prefix side base_link root_xyz root_rpy master:=''">

    <xacro:seg name="${prefix}${side}_seg1" mesh="seg1.stl" slen="${l1}" comp="${-c1}" mass="0.006"/>
    <xacro:seg name="${prefix}${side}_seg2" mesh="seg2.stl" slen="${l2}" comp="${-c2}" mass="0.006"/>
    <xacro:seg name="${prefix}${side}_seg3" mesh="seg3.stl" slen="${l3}" comp="${-c3}" mass="0.005"/>
    <xacro:seg name="${prefix}${side}_seg4" mesh="seg4.stl" slen="${l4}" comp="${-c4}" mass="0.007"/>

    <!-- Base del dedo FIJA al acople -->
    <joint name="${prefix}${side}_mount" type="fixed">
      <parent link="${base_link}"/>
      <child  link="${prefix}${side}_seg1"/>
      <origin xyz="${root_xyz}" rpy="${root_rpy}"/>
    </joint>

    <!-- Junta MAESTRA proximal (seg1->seg2): la "presion". -->
    <joint name="${prefix}${side}_joint" type="revolute">
      <parent link="${prefix}${side}_seg1"/>
      <child  link="${prefix}${side}_seg2"/>
      <origin xyz="${l1} 0 0"/>
      <axis xyz="${bend_axis}"/>
      <!--<limit lower="0.0" upper="1.0" effort="20" velocity="1.0"/> -->
      <limit lower="-0.01" upper="1.0" effort="20" velocity="1.0"/>
      <dynamics damping="0.1"/>
    </joint>

    <joint name="${prefix}${side}_j23" type="revolute">
      <parent link="${prefix}${side}_seg2"/>
      <child  link="${prefix}${side}_seg3"/>
      <origin xyz="${l2} 0 0"/>
      <axis xyz="${bend_axis}"/>
      <limit lower="-0.01" upper="1.0" effort="20" velocity="1.0"/>
      <dynamics damping="0.05"/>
    </joint>

    <joint name="${prefix}${side}_j34" type="revolute">
      <parent link="${prefix}${side}_seg3"/>
      <child  link="${prefix}${side}_seg4"/>
      <origin xyz="${l3} 0 0"/>
      <axis xyz="${bend_axis}"/>
      <limit lower="-0.05" upper="1.05" effort="20" velocity="1.0"/>
      <!--<limit lower="-0.01" upper="1.0" effort="20" velocity="1.0"/> -->
      <dynamics damping="0.05"/>
    </joint>
  </xacro:macro>

  <!-- ========================================================================
       MACRO PRINCIPAL
       ======================================================================== -->
  <xacro:macro name="soft_gripper" params="parent_link prefix:='g_'">

    <!-- Acople sobre tool0 (STL recolocado: origen en cara de brida, Z->dedos) -->
    <link name="${prefix}base">
      <visual>
        <geometry><mesh filename="${acople_mesh}" scale="${ms} ${ms} ${ms}"/></geometry>
        <material name="mount_grey"/>
      </visual>
      <collision>
        <!-- cilindro aprox. del cuerpo del acople (de la cara a los brazos) -->
        <geometry><cylinder radius="0.033" length="0.060"/></geometry>
        <origin xyz="0 0 0.023"/>
      </collision>
      <inertial>
        <origin xyz="-0.000184 -0.000099 0.016035" rpy="0 0 0"/>
        <mass value="0.075789"/>
        <inertia ixx="4.909e-5" ixy="-1.283e-7" ixz="-6.989e-8"
                 iyy="3.584e-5" iyz="5.760e-8"
                 izz="4.793e-5"/>
      </inertial>
    </link>

    <!-- IDENTIDAD: el STL ya trae el origen en la cara de tool0 -->
    <joint name="${prefix}mount" type="fixed">
      <parent link="${parent_link}"/>
      <child  link="${prefix}base"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Dedos: root_xyz/root_rpy PROVISIONALES (ahora +Z = aproximacion).
         pitch -90 apunta el dedo (X local) por +Z ; splay abre la V. -->
    <xacro:finger prefix="${prefix}" side="left"  base_link="${prefix}base"
                  root_xyz="0 ${-mouth_y} ${mouth_z}"
                  root_rpy="${finger_roll} -0.9599 -1.5708"/>

    <xacro:finger prefix="${prefix}" side="right" base_link="${prefix}base"
                  root_xyz="0 ${mouth_y} ${mouth_z}"
                  root_rpy="${finger_roll} -0.9599 1.5708"
                  master="${prefix}left_joint"/>

  </xacro:macro>

  <!-- ========================================================================
       Gazebo: friccion en las falanges (agarre).
       ======================================================================== -->
  <xacro:macro name="seg_gz" params="link">
    <gazebo reference="${link}">
      <mu1>2.0</mu1><mu2>2.0</mu2><kp>1e6</kp><kd>50</kd><minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>
  <xacro:seg_gz link="g_left_seg2"/>  <xacro:seg_gz link="g_left_seg3"/>  <xacro:seg_gz link="g_left_seg4"/>
  <xacro:seg_gz link="g_right_seg2"/> <xacro:seg_gz link="g_right_seg3"/> <xacro:seg_gz link="g_right_seg4"/>

  <!-- ========================================================================
       ALTERNATIVA COMPLIANTE (adaptacion al objeto):
       Quita el 'mimic' de _j23 y _j34 (pasivas) y añade muelle en Gazebo:
       <gazebo reference="g_left_j23"><spring_stiffness>0.4</spring_stiffness><spring_reference>0.0</spring_reference></gazebo>
       <gazebo reference="g_left_j34"><spring_stiffness>0.4</spring_stiffness><spring_reference>0.0</spring_reference></gazebo>
       <gazebo reference="g_right_j23"><spring_stiffness>0.4</spring_stiffness><spring_reference>0.0</spring_reference></gazebo>
       <gazebo reference="g_right_j34"><spring_stiffness>0.4</spring_stiffness><spring_reference>0.0</spring_reference></gazebo>
       ======================================================================== -->

</robot>
