<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="robot_cell">
    <!-- ===================== GRUPOS ===================== -->
    <group name="ur_arm">
        <chain base_link="ur3_base_link" tip_link="ur3_tool0"/>
    </group>
    <group name="gripper">
        <joint name="g_left_joint"/>
        <joint name="g_left_j23"/>
        <joint name="g_left_j34"/>
        <joint name="g_right_joint"/>
        <joint name="g_right_j23"/>
        <joint name="g_right_j34"/>
    </group>

    <!-- ===================== ESTADO AGARRE CENITAL ===================== -->
    
    <group_state name="init" group="ur_arm">
        <joint name="ur3_elbow_joint" value="0.959931"/>
        <joint name="ur3_shoulder_lift_joint" value="-0.680678"/>
        <joint name="ur3_shoulder_pan_joint" value="0.279253"/>
        <joint name="ur3_wrist_1_joint" value="1.256637"/>
        <joint name="ur3_wrist_2_joint" value="1.570796"/>
        <joint name="ur3_wrist_3_joint" value="-2.862334"/>
    </group_state>
    <!-- ===================== ESTADO AGARRE CENITAL cilindro inclionado 110 y 120===================== -->
