<?xml version="1.0" ?>
<!-- Cilindro solido. Diametro 110 mm (radio 0.055 m) x altura 100 mm.
     Masa 50 g. Friccion mu=mu2=1.2. Eje vertical (de pie).
     Inercia: Izz=7.5625e-05  Ixx=Iyy=7.9479e-05 -->
<sdf version="1.10">
  <model name="cilindro_110">
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>7.9479e-05</ixx><iyy>7.9479e-05</iyy><izz>7.5625e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.055</radius><length>0.1</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>1e2</kd></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.055</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
