<?xml version="1.0" ?>
<!-- Cilindro solido. Diametro 10 mm (radio 0.005 m) x altura 100 mm.
     Masa 50 g. Friccion mu=mu2=1.2. Eje vertical (de pie).
     Inercia: Izz=6.2500e-07  Ixx=Iyy=4.1979e-05 -->
<sdf version="1.10">
  <model name="cilindro_10">
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>4.1979e-05</ixx><iyy>4.1979e-05</iyy><izz>6.2500e-07</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.005</radius><length>0.1</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>1e2</kd></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.005</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.9 0.3 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
