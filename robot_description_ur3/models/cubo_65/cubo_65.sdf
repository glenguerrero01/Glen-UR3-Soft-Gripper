<?xml version="1.0" ?>
<!-- Cubo lado=65 mm.  Masa 50 g. Friccion mu=mu2=1.2. -->
<sdf version="1.10">
  <model name="cubo_65">
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>3.5208e-05</ixx><iyy>3.5208e-05</iyy><izz>3.5208e-05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.065 0.065 0.065</size></box></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>1e2</kd></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.065 0.065 0.065</size></box></geometry>
        <material><ambient>0.2 0.7 0.3 1</ambient><diffuse>0.2 0.7 0.3 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
