<?xml version="1.0" ?>
<!-- Objeto de prueba: cilindro solido para ensayos de agarre.
     Diametro 25 mm (radio 0.0125 m) x altura 100 mm (0.1 m).
     Masa 50 g. Friccion mu = mu2 = 1.0. Eje del cilindro vertical (Z) = "de pie".
     Inercia de cilindro solido:
       Izz = 0.5*m*r^2                 = 3.906e-6
       Ixx = Iyy = (1/12)*m*(3r^2+h^2) = 4.362e-5
-->
<sdf version="1.10">
  <model name="cilindro_25">
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>4.362e-5</ixx>
          <iyy>4.362e-5</iyy>
          <izz>3.906e-6</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.0125</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1e2</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.0125</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.3 0.1 1</ambient>
          <diffuse>0.9 0.3 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
